{
  "name": "homecast",
  "version": "0.3.0",
  "description": "Stream your PC's movies, videos and photos to every TV on your home Wi-Fi. One exe, no cloud.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:client && node server/main.ts",
    "build:client": "node tools/build-client.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "test": "vitest run",
    "e2e": "npm run build:client && playwright test",
    "fixtures": "node tools/fixtures/generate.ts",
    "package": "node tools/package.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "bonjour-service": "^1.4.4",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hono": "^4.13.13",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "hls.js": "^1.7.3",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
